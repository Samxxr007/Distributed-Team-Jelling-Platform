{
  "title": "Jelling Overview",
  "panels": [
    { "title": "HTTP Request Duration", "type": "timeseries", "targets": [ { "expr": "rate(http_request_duration_seconds_sum[5m]) / rate(http_request_duration_seconds_count[5m])" } ] },
    { "title": "HTTP Requests Total", "type": "stat", "targets": [ { "expr": "sum(rate(http_requests_total[5m]))" } ] },
    { "title": "Backend CPU Usage", "type": "timeseries", "targets": [ { "expr": "rate(process_cpu_seconds_total{job='backend'}[5m])" } ] },
    { "title": "Backend Memory Usage", "type": "timeseries", "targets": [ { "expr": "process_resident_memory_bytes{job='backend'}" } ] },
    { "title": "Sentiment CPU Usage", "type": "timeseries", "targets": [ { "expr": "rate(process_cpu_seconds_total{job='sentiment-service'}[5m])" } ] },
    { "title": "Sentiment Memory Usage", "type": "timeseries", "targets": [ { "expr": "process_resident_memory_bytes{job='sentiment-service'}" } ] }
  ]
}
